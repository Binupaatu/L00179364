import { useState } from 'react'
import reactLogo from './assets/react.svg'
import ToDoForm from './components/ToDoForm'
import viteLogo from '/vite.svg'
import './App.css'


function App() {

const [confirmation, setConfirmation] = useState("");
const [formData, setFormData] = useState({
    item: ""
  });
   function handleUserFormSubmit(e, data) {
        e.preventDefault();
           setFormData(data);
           fetch("http://localhost:8080/todolist",
             {
               method: "POST",
               body: JSON.stringify(data)
             }
           )
             .then(response => response.json())
             .then(() => {
               setConfirmation("Form submitted successfully!");
               setFormData({
                 item: ""
               });
             }
             );
           console.log("Form submitted", data);
    }
  return (
    <>

     <ToDoForm formData={formData} onFormSubmit={handleUserFormSubmit} confirmation={confirmation} />
    </>
  )
}

export default App







import React, { useState } from "react";

function ToDoForm({formData, onFormSubmit, confirmation}) {

    const [localFormData, setLocalFormData] = useState(formData);
    function handleSubmit(e) {
        e.preventDefault();
        onFormSubmit(e, localFormData);
    }

    function handleChange(e) {
        const { name, value } = e.target;
        setLocalFormData({
            ...localFormData,
            [name]: value
        });
    }
    return (
        <>
        <form onSubmit={handleSubmit}>
            <label htmlFor="itemName">ToDo Item: </label>
            <input type="text" id="item" name="item" value={localFormData.name} onChange={handleChange} required />
            <button type="submit">AddToList</button>
            <button type="submit">ToDoList</button>
        </form>
        { confirmation ?
            <p>{confirmation}</p> : ""
        }

        </>
    )
}

export default ToDoForm;


