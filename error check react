import React from "react";

function ToDoList({ items, onDelete, onEdit }) {
    return (
        <div>
            <h2>To-Do List</h2>
            <ul>
                {items.length > 0 ? (
                    items.map((item) => (
                        <li key={item.id}>
                            {item.item}
                            <button onClick={() => onEdit(item.id)}>Edit</button>
                            <button onClick={() => onDelete(item.id)}>Delete</button>

                            </li>
                    ))
                ) : (
                    <p>No items found.</p>
                )}
            </ul>
        </div>
    );
}

export default ToDoList;


