import React, { useState,useEffect } from "react";

function ToDoForm({formData, onFormSubmit, confirmation,fetchToDoList}) {

    const [localFormData, setLocalFormData] = useState(formData);
    useEffect(()=>{
    setLocalFormData(formData);
    },[formData]);

    function handleSubmit(e,actionType) {
        e.preventDefault();
        if(actionType=== "add"){
            onFormSubmit(e, localFormData);
            }

        else if(actionType === "list")
        fetchToDoList();
    }

    function handleChange(e) {
        const { name, value } = e.target;
        setLocalFormData({
            ...localFormData,
            [name]: value
        });
    }
    return (
        <>
        <form onSubmit={(e) => onFormSubmit(e,localFormData)}>
            <label htmlFor="itemName">ToDo Item: </label>
            <input type="text" id="item" name="item" value={localFormData.item} onChange={handleChange} required />
            <button type="submit" onClick={(e)=> handleSubmit(e,"add")}>AddToList</button>
            {/*<button type="button" onClick={(e)=> handleSubmit(e,"list")}>To-DOList</button>*/}
        </form>
        { confirmation ?
            <p>{confirmation}</p> : ""
        }

        </>
    )
}

export default ToDoForm;


