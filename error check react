function App() {

const [confirmation, setConfirmation] = useState("");
const [formData, setFormData] = useState({
    item: ""
  });
  const [toDoItems,setToDoItems]=useState([]);
  const [editingItem,setEditingItem]=useState(null);
  function handleUserFormSubmit(e, data) {
        e.preventDefault();
           setFormData(data);
           if(editingItem)
           {
               fetch('http://localhost:8080/todolist/${editingItem.id}',{
               method : "PUT",
               headers : {
                   "Content-Type" : "application/json"},
       body : JSON.stringify(data),
                   })
               .then(() =>{
               setConfirmation("To-Do item updated successfully");
               setEditingItem(null);
               fetchToDoList();});
               }
           else
           {
               fetch("http://localhost:8080/todolist",
             {
               method: "POST",
               headers:{
                   "Content-Type" : "application/json"
                       },
               body: JSON.stringify(data)
             }
           )
             .then(response => response.json())
             .then(() => {
               setConfirmation("Form submitted successfully!");
               setFormData({
                 item: ""
               });
           fetchToDoList();
             }
             );
           console.log("Form submitted", data);
           }

    }
        function fetchToDoList(){
               fetch("http://localhost:8080/todolist")
               .then((response)=> response.json())
               .then((data)=> setToDoItems(data))
               .catch((error) => console.error("error in fetching to-do list: ", error));

    }
function handleDelete(id){
    console.log("Deleting id:",id)
    fetch(`http://localhost:8080/todolist/${id}`,{
    method:"DELETE",
    })
    .then(() => { setConfirmation("To-Do list item deleted successfully");
    fetchToDoList();
    })
    .catch((error) => console.error("error deleting item : ",error));
    }

function handleEdit(item){
    setFormData(item);
    setEditingItem(item);
    }
useEffect(() => {fetchToDoList();},[]);
  return (
    <>

     <ToDoForm formData={formData}
     onFormSubmit={handleUserFormSubmit}
     confirmation={confirmation}
      fetchToDoList={fetchToDoList}/>
    <ToDoList items={toDoItems} onDelete={handleDelete} onEdit={handleEdit}/>
         </>
  )
}

export default App
