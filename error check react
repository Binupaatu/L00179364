import { useState, useEffect } from 'react'
import reactLogo from './assets/react.svg'
import ToDoForm from './components/ToDoForm'
import ToDoList from './components/ToDoList'

import viteLogo from '/vite.svg'
import './App.css'


function App() {

const [confirmation, setConfirmation] = useState("");
const [formData, setFormData] = useState({
    item: ""
  });
  const [toDoItems,setToDoItems]=useState([]);

  function handleUserFormSubmit(e, data) {
        e.preventDefault();
           setFormData(data);
           fetch("http://localhost:8080/todolist",
             {
               method: "POST",
               headers:{
                   "Content-Type" : "application/json"
                       },
               body: JSON.stringify(data)
             }
           )
             .then(response => response.json())
             .then(() => {
               setConfirmation("Form submitted successfully!");
               setFormData({
                 item: ""
               });
             }
             );
           console.log("Form submitted", data);
    }
        function fetchToDoList(){
               fetch("http://localhost:8080/todolist")
               .then((response)=> response.json())
               .then((data)=> setToDoItems(data))
               .catch((error) => console.error("error in fetching to-do list: ", error));

    }
useEffect(() => {fetchToDoList();},[]);
  return (
    <>

     <ToDoForm formData={formData} onFormSubmit={handleUserFormSubmit} confirmation={confirmation} />
     <ToDoList items={toDoItems}/>
         </>
  )
}

export default App
