import { useState } from "react";
import happy from "../images/happypuppy.png";
import sad from "../images/sadpuppy.png";
function petSimulator(){
    const[isHappy,setIsHappy]=useState(false);
    const[isSad,setIsSad]=useState(false);
    function handlefeed()
    {
        setIsHappy(!isHappy);
    }
    function handleplay()
    {
        setIsSad(!isSad);
    }
return(
    <>
    <img src={isHappy ? happy:isSad} alt="puppy" width="200" height="200"/>
    <img src={isSad ? isSad:happy} alt="puppy" width="200" height="200"/>
    <button onClick={handlefeed}>feed</button>
    <button onClick={handleplay}>play</button>
    </>
)

}
export default petSimulator;
