import { useEffect, useState } from "react";
function UserList(){
    const[users,setUsers]=useState([]);
    const[loading, setLoading]=useState(true);

    useEffect(() =>{
        fetch("http://localhost:8080/api/users")
        .then (response => response.json())
        .then (data =>{
            setUsers(data["users"]);
            setLoading(false);
        })
    },[]
    )

    if(loading){
        return <p>loading....</p>
    }
    return(
        <div>
            <h2>The Users</h2>
           {
            users.map(user =>{
                return(
                    <div key={user.id}>
                        <h3>{user.name}</h3>

                    </div>
                )
            }

            )
           }
        </div>
    )

}
export default UserList
